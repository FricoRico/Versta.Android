import kotlin.String;
import kotlin.collections.List;
import kotlin.collections.Map;

CREATE TABLE VoiceModel (
    id TEXT NOT NULL PRIMARY KEY,
    baseModel TEXT NOT NULL,
    architectures TEXT AS List<String> NOT NULL,
    path TEXT NOT NULL,
    version TEXT NOT NULL
);

getAll:
SELECT * FROM VoiceModel;

getById:
SELECT * FROM VoiceModel WHERE id = :id LIMIT 1;

upsert {
    UPDATE VoiceModel SET
        baseModel = :baseModel,
        architectures = :architectures,
        path = :path,
        version = :version
    WHERE id = :id;

    INSERT OR IGNORE INTO VoiceModel (
        id,
        baseModel,
        architectures,
        path,
        version
    ) VALUES (
        :id,
        :baseModel,
        :architectures,
        :path,
        :version
    );
}

deleteById:
DELETE FROM VoiceModel WHERE id = :id;

deleteByIds:
DELETE FROM VoiceModel WHERE id IN :ids;