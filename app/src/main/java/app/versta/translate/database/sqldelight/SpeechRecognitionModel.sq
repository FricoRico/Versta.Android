import kotlin.String;
import kotlin.collections.List;

CREATE TABLE SpeechRecognitionModel (
    id TEXT NOT NULL PRIMARY KEY,
    baseModel TEXT NOT NULL,
    architectures TEXT AS List<String> NOT NULL,
    path TEXT NOT NULL,
    version TEXT NOT NULL
);

getAll:
SELECT * FROM SpeechRecognitionModel;

getById:
SELECT * FROM SpeechRecognitionModel WHERE id = :id LIMIT 1;

upsert {
    UPDATE SpeechRecognitionModel SET
        baseModel = :baseModel,
        architectures = :architectures,
        path = :path,
        version = :version
    WHERE id = :id;

    INSERT OR IGNORE INTO SpeechRecognitionModel (
        id,
        baseModel,
        architectures,
        path,
        version
    ) VALUES (
        :id,
        :baseModel,
        :architectures,
        :path,
        :version
    );
}

deleteById:
DELETE FROM SpeechRecognitionModel WHERE id = :id;
